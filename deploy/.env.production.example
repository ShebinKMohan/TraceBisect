# Public hostname. Point its A/AAAA record at this server before first start.
TRACEBISECT_STUDIO_DOMAIN=studio.example.com

# Generate these with the TraceBisect CLI. Never commit real values.
TRACEBISECT_STUDIO_API_KEY_PEPPER=replace-with-generated-managed-key-secret
TRACEBISECT_STUDIO_IDENTITY_SECRET=replace-with-generated-human-identity-secret
TRACEBISECT_STUDIO_METRICS_TOKEN=replace-with-generated-metrics-token

# Optional invitation email. Leave provider as none to use one-time manual links.
TRACEBISECT_STUDIO_EMAIL_PROVIDER=none
TRACEBISECT_STUDIO_EMAIL_FROM=TraceBisect <invites@example.com>
TRACEBISECT_STUDIO_EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
